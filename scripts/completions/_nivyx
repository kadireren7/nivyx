#compdef nivyx
# zsh completion for nivyx
local -a cmds
cmds=(
	'status:is it working?'
	'start:start the service'
	'stop:stop the service (networking untouched)'
	'restart:restart the service'
	'reload:reload manual rules'
	'logs:recent log lines'
	'doctor:read-only health checks'
	'diagnose:explain what happens for one site'
	'stats:local counters'
	'config:show, check or change manual rules'
	'update:update to the latest release'
	'repair:fix Nivyx-owned state'
	'strategy:which rule applies to a domain'
	'support-bundle:redacted diagnostics archive'
	'version:print the version'
	'help:help for a command'
)
if (( CURRENT == 2 )); then
	_describe 'command' cmds
	return
fi
case $words[2] in
	status|diagnose) _values 'option' '--verbose' ;;
	update) _values 'option' '--check' ;;
	config)
		if (( CURRENT == 3 )); then _values 'subcommand' show path check set unset
		elif [[ $words[3] == set ]] && (( CURRENT == 5 )); then _values 'strategy' pass tlsrec tlsrec-split
		fi ;;
	help) (( CURRENT == 3 )) && _describe 'command' cmds ;;
esac
